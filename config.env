# TMWatch configuration

# Alert when Added + Changed data reaches this size.
THRESHOLD_GIB=25

# Stop a comparison if it runs longer than this.
CHECK_TIMEOUT_SECONDS=3600

# Do not repeat warning notifications more often than this.
NOTIFY_COOLDOWN_SECONDS=21600

# Number of largest changed/added items shown by `tmwatch details`.
TOP_ITEMS=15

# macOS notification sound.
SOUND_NAME="Basso"
